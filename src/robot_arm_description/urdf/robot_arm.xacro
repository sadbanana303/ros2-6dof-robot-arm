<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="robot_arm">

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ==================== -->
  <!-- Materials             -->
  <!-- ==================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>


  <!-- ==================== -->
  <!-- Base                  -->
  <!-- ==================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <cylinder radius="0.25" length="0.2"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.1"/>
      <geometry>
        <cylinder radius="0.25" length="0.2"/>
      </geometry>
    </collision>
  <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.05"/>
    </inertial>
  </link>


  <!-- ==================== -->
  <!-- Link 1                -->
  <!-- ==================== -->

  <link name="link1">

    <visual>
      <origin xyz="0 0 0.3"/>
      <geometry>
        <box size="0.18 0.18 0.6"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.3"/>
      <geometry>
        <box size="0.18 0.18 0.6"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.3"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.1"
        ixy="0"
        ixz="0"
        iyy="0.1"
        iyz="0"
        izz="0.1"/>
    </inertial>

  </link>


  <!-- ==================== -->
  <!-- Joint 1               -->
  <!-- ==================== -->

  <joint name="joint1" type="revolute">

    <parent link="base_link"/>
    <child link="link1"/>

    <origin xyz="0 0 0.2"/>

    <axis xyz="0 0 1"/>

    <dynamics damping="25.0" friction="1.0"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="60"
      velocity="1.0"/>

  </joint>


  <!-- ==================== -->
  <!-- Link 2                -->
  <!-- ==================== -->

  <link name="link2">

    <visual>
      <origin xyz="0 0 0.5"/>
      <geometry>
        <box size="0.18 0.18 1.0"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.5"/>
      <geometry>
        <box size="0.18 0.18 1.0"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.5"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.2"
        ixy="0"
        ixz="0"
        iyy="0.2"
        iyz="0"
        izz="0.2"/>
    </inertial>

  </link>


  <!-- ==================== -->
  <!-- Joint 2               -->
  <!-- ==================== -->

  <joint name="joint2" type="revolute">

    <parent link="link1"/>
    <child link="link2"/>

    <origin xyz="0 0 0.6"/>

    <axis xyz="0 1 0"/>
    <dynamics damping="25.0" friction="1.0"/>
    <limit
      lower="-1.57"
      upper="1.57"
      effort="80"
      velocity="1.0"/>

  </joint>


  <!-- ==================== -->
  <!-- Link 3                -->
  <!-- ==================== -->

  <link name="link3">

    <visual>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <box size="0.16 0.16 0.8"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <box size="0.16 0.16 0.8"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>


  <!-- ==================== -->
  <!-- Joint 3               -->
  <!-- ==================== -->

  <joint name="joint3" type="revolute">

    <parent link="link2"/>
    <child link="link3"/>

    <origin xyz="0 0 1.0"/>

    <axis xyz="0 1 0"/>
    <dynamics damping="18.0" friction="0.8"/>
    <limit
      lower="-2.0"
      upper="2.0"
      effort="60"
      velocity="1.0"/>

  </joint>


  <!-- ==================== -->
  <!-- Link 4                -->
  <!-- ==================== -->

  <link name="link4">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.14 0.14 0.3"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.14 0.14 0.3"/>
      </geometry>
    </collision>
    <inertial>
       <origin xyz="0 0 0" rpy="0 0 0"/>
       <mass value="1.0"/>
       <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>


  <!-- ==================== -->
  <!-- Joint 4               -->
  <!-- ==================== -->

  <joint name="joint4" type="revolute">

    <parent link="link3"/>
    <child link="link4"/>

    <origin xyz="0 0 0.8"/>

    <axis xyz="0 0 1"/>
    <dynamics damping="10.0" friction="0.4"/>
    <limit
      lower="-3.14"
      upper="3.14"
      effort="30"
      velocity="1.0"/>

  </joint>


  <!-- ==================== -->
  <!-- Link 5                -->
  <!-- ==================== -->

  <link name="link5">

    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.12 0.12 0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.12 0.12 0.3"/>
      </geometry>
    </collision>
    <inertial>
       <origin xyz="0 0 0" rpy="0 0 0"/>
       <mass value="1.0"/>
           <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>

  </link>


  <!-- ==================== -->
  <!-- Joint 5               -->
  <!-- ==================== -->

  <joint name="joint5" type="revolute">

    <parent link="link4"/>
    <child link="link5"/>

    <origin xyz="0 0 0.3"/>

    <axis xyz="0 1 0"/>
      <dynamics damping="10.0" friction="0.4"/>
    <limit
      lower="-1.57"
      upper="1.57"
      effort="25"
      velocity="1.0"/>

  </joint>


  <!-- ==================== -->
  <!-- End Effector          -->
  <!-- ==================== -->

  <link name="tool_link">

    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.15"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>

  </link>


  <!-- ==================== -->
  <!-- Joint 6               -->
  <!-- ==================== -->

  <joint name="joint6" type="revolute">

    <parent link="link5"/>
    <child link="tool_link"/>

    <origin xyz="0 0 0.3"/>

    <axis xyz="0 0 1"/>
  <dynamics damping="5.0" friction="0.2"/>
    <limit
      lower="-3.14"
      upper="3.14"
      effort="15"
      velocity="1.0"/>

  </joint>
  <ros2_control name="RobotArmSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

   <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/nandanan/robot_arm_ws/install/robot_arm_description/share/robot_arm_description/config/controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <position_proportional_gain>6.0</position_proportional_gain>
    </plugin>
  </gazebo>
</robot>
